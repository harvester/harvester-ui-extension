metadata.fields[5]\"}],\"group\":\"rbac.authorization.k8s.io\",\"kind\":\"ClusterRoleBinding\",\"namespaced\":false,\"resource\":\"clusterrolebindings\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"rke.cattle.io.rkecontrolplane\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/rke.cattle.io.rkecontrolplanes\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/rke.cattle.io.rkecontrolplane\"},\"description\":\"RKEControlPlane is the Schema for the controlplane.\",\"pluralName\":\"rke.cattle.io.rkecontrolplanes\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Cluster\",\"field\":\".metadata.labels['cluster\\\\.x-k8s\\\\.io/cluster-name']\",\"type\":\"string\"},{\"name\":\"Initialized\",\"field\":\".status.initialized\",\"type\":\"string\"},{\"name\":\"API Server Available\",\"field\":\".status.initialization.controlPlaneInitialized\",\"type\":\"boolean\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"},{\"name\":\"Version\",\"field\":\".spec.kubernetesVersion\",\"type\":\"string\"}],\"crd\":true,\"group\":\"rke.cattle.io\",\"hasObservedGeneration\":true,\"kind\":\"RKEControlPlane\",\"namespaced\":true,\"resource\":\"rkecontrolplanes\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"snapshot.kubevirt.io.virtualmachinesnapshotcontent\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/snapshot.kubevirt.io.virtualmachinesnapshotcontents\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/snapshot.kubevirt.io.virtualmachinesnapshotcontent\"},\"description\":\"VirtualMachin