llectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"BackingImage\",\"field\":\".status.backingImage\",\"type\":\"string\"},{\"name\":\"Size\",\"field\":\".status.size\",\"type\":\"string\"},{\"name\":\"BackupCreatedAt\",\"field\":\".status.backupCreatedAt\",\"type\":\"string\"},{\"name\":\"State\",\"field\":\".status.state\",\"type\":\"string\"},{\"name\":\"LastSyncedAt\",\"field\":\".status.lastSyncedAt\",\"type\":\"string\"}],\"crd\":true,\"group\":\"longhorn.io\",\"kind\":\"BackupBackingImage\",\"namespaced\":true,\"resource\":\"backupbackingimages\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"monitoring.coreos.com.thanosruler\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/monitoring.coreos.com.thanosrulers\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/monitoring.coreos.com.thanosruler\"},\"description\":\"The `ThanosRuler` custom resource definition (CRD) defines a desired [Thanos Ruler](https://github.com/thanos-io/thanos/blob/main/docs/components/rule.md) setup to run in a Kubernetes cluster.\\n\\nA `ThanosRuler` instance requires at least one compatible Prometheus API endpoint (either Thanos Querier or Prometheus services).\\n\\nThe resource defines via label and namespace selectors which `PrometheusRule` objects should be associated to the deployed Thanos Ruler instances.\",\"pluralName\":\"monitoring.coreos.com.thanosrulers\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Version\",\"field\":\".spec.version\",\"type\":\"string\"},{\"name\":\"Replicas\",\"field\":\".spec.replicas\",\"type\":\"integer\"},{\"name\":\"Ready\",\"field\":\".status.availableReplicas\",\"type\":\"integer\"},{\"name\":\"Reconciled\",\"field\":\".status.conditions[?(@.type == 'Reconciled')].status\",\"type\":\"string\"},{\"name\":\"Available\",\"field\":\".status.conditions[?(@.type == 'Available')].status\",\"type\":\"string\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"},{\"name\":\"Paused\",\"field\":\".status.paused\",\"type\":\"boolean\"}],\"crd\":true,\"group\":\"monitoring.coreos.com\",\"kind\":\"ThanosRuler\",\"namespaced\":true,\"resource\":\"thanosrulers\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"autoscaling.horizontalpodautoscaler\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/autoscaling.horizontalpodautoscalers\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/autoscaling.horizontalpodautoscaler\"},\"description\":\"HorizontalPodAutoscaler is the configuration for a horizontal pod autoscaler, which automatically manages the replica count of any resource implementing the scale subresource based on the metrics specified.\",\"pluralName\":\"autoscaling.horizontalpodautoscalers\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Reference\",\"type\":\"string\",\"format\":\"\",\"description\":\"scaleTargetRef points to the target resource to scale, and is used to the pods for which metrics should be collected, as well as to actually change the replica count.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Targets\",\"type\":\"string\",\"format\":\"\",\"description\":\"metrics contains the specifications for which to use to calculate the desired replica count (the maximum replica count across all metrics will be used).  The desired replica count is calculated multiplying the ratio between the target value and the current value by the current number of pods.  Ergo, metrics used must decrease as the pod count is increased, and vice-versa.  See the individual metric source types for more information about how each type of metric must respond. If not set, the default metric will be set to 80% average CPU utilization.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"MinPods\",\"type\":\"string\",\"format\":\"\",\"description\":\"minReplicas is the lower limit for the number of replicas to which the autoscaler can scale down.  It defaults to 1 pod.  minReplicas is allowed to be 0 if the alpha feature gate HPAScaleToZero is enabled and at least one Object or External metric is configured.  Scaling is active as long as at least one metric value is available.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"MaxPods\",\"type\":\"string\",\"format\":\"\",\"description\":\"maxReplicas is the upper limit for the number of replicas to which the autoscaler can scale up. It cannot be less that minReplicas.\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Replicas\",\"type\":\"string\",\"format\":\"\",\"description\":\"currentReplicas is current number of replicas of pods managed by this autoscaler, as last seen by the autoscaler.\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"}],\"group\":\"autoscaling\",\"kind\":\"HorizontalPodAutoscaler\",\"namespaced\":true,\"resource\":\"horizontalpodautoscalers\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v2\"}},{\"id\":\"management.cattle.io.authconfig\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/management.cattle.io.authconfigs\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/management.cattle.io.authconfig\"},\"pluralName\":\"management.cattle.io.authconfigs\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"management.cattle.io\",\"kind\":\"AuthConfig\",\"namespaced\":false,\"resource\":\"authconfigs\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"forklift.konveyor.io.host\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/forklift.konveyor.io.hosts\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/forklift.konveyor.io.host\"},\"pluralName\":\"forklift.konveyor.io.hosts\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"READY\",\"field\":\".status.conditions[?(@.type=='Ready')].status\",\"type\":\"string\"},{\"name\":\"CONNECTED\",\"field\":\".status.conditions[?(@.type=='ConnectionTestSucceeded')].status\",\"type\":\"string\"},{\"name\":\"AGE\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"forklift.konveyor.io\",\"hasObservedGeneration\":true,\"kind\":\"Host\",\"namespaced\":true,\"resource\":\"hosts\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"gateway.networking.k8s.io.backendtlspolicy\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/gateway.networking.k8s.io.backendtlspolicies\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/gateway.networking.k8s.io.backendtlspolicy\"},\"description\":\"BackendTLSPolicy provides a way to configure how a Gateway\\nconnects to a Backend via TLS.\",\"pluralName\":\"gateway.networking.k8s.io.backendtlspolicies\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"gateway.networking.k8s.io\",\"kind\":\"BackendTLSPolicy\",\"namespaced\":true,\"resource\":\"backendtlspolicies\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"discovery.k8s.io.endpointslice\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/discovery.k8s.io.endpointslices\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/discovery.k8s.io.endpointslice\"},\"description\":\"EndpointSlice represents a set of service endpoints. Most EndpointSlices are created by the EndpointSlice controller to represent the Pods selected by Service objects. For a given service there may be multiple EndpointSlice objects which must be joined to produce the full set of endpoints; you can find all of the slices for a given service by listing EndpointSlices in the service's namespace whose `kubernetes.io/service-name` label contains the service's name.\",\"pluralName\":\"discovery.k8s.io.endpointslices\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"AddressType\",\"type\":\"string\",\"format\":\"\",\"description\":\"addressType specifies the type of address carried by this EndpointSlice. All addresses in this slice must be the same type. This field is immutable after creation. The following address types are currently supported: * IPv4: Represents an IPv4 Address. * IPv6: Represents an IPv6 Address. * FQDN: Represents a Fully Qualified Domain Name. (Deprecated) The EndpointSlice controller only generates, and kube-proxy only processes, slices of addressType \\\"IPv4\\\" and \\\"IPv6\\\". No semantics are defined for the \\\"FQDN\\\" type.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Ports\",\"type\":\"string\",\"format\":\"\",\"description\":\"ports specifies the list of network ports exposed by each endpoint in this slice. Each port must have a unique name. Each slice may include a maximum of 100 ports. Services always have at least 1 port, so EndpointSlices generated by the EndpointSlice controller will likewise always have at least 1 port. EndpointSlices used for other purposes may have an empty ports list.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Endpoints\",\"type\":\"string\",\"format\":\"\",\"description\":\"endpoints is a list of unique endpoints in this slice. Each slice may include a maximum of 1000 endpoints.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"}],\"group\":\"discovery.k8s.io\",\"kind\":\"EndpointSlice\",\"namespaced\":true,\"resource\":\"endpointslices\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"harvesterhci.io.volumeremoterestore\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/harvesterhci.io.volumeremoterestores\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/harvesterhci.io.volumeremoterestore\"},\"pluralName\":\"harvesterhci.io.volumeremoterestores\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"type\",\"field\":\".spec.type\",\"type\":\"string\"},{\"name\":\"from\",\"field\":\".spec.from\",\"type\":\"string\"},{\"name\":\"Success\",\"field\":\".status.success\",\"type\":\"boolean\"}],\"crd\":true,\"group\":\"harvesterhci.io\",\"kind\":\"VolumeRemoteRestore\",\"namespaced\":true,\"resource\":\"volumeremoterestores\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"node.harvesterhci.io.ksmtuned\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/node.harvesterhci.io.ksmtuneds\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/node.harvesterhci.io.ksmtuned\"},\"pluralName\":\"node.harvesterhci.io.ksmtuneds\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Run\",\"field\":\".spec.run\",\"type\":\"string\"},{\"name\":\"Mode\",\"field\":\".spec.mode\",\"type\":\"string\"}],\"crd\":true,\"group\":\"node.harvesterhci.io\",\"kind\":\"Ksmtuned\",\"namespaced\":false,\"resource\":\"ksmtuneds\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\