\":{\"collection\":\"https://harvester.invalid/v1/resource.k8s.io.deviceclasses\",\"self\":\"https://harvester.invalid/v1/schemas/resource.k8s.io.deviceclass\"},\"description\":\"DeviceClass is a vendor- or admin-provided resource that contains device configuration and selectors. It can be referenced in the device requests of a claim to apply these presets. Cluster scoped.\\n\\nThis is an alpha type and requires enabling the DynamicResourceAllocation feature gate.\",\"pluralName\":\"resource.k8s.io.deviceclasses\",\"resourceMethods\":[\"DELETE\",\"PUT\",\"PATCH\",\"GET\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"group\":\"resource.k8s.io\",\"kind\":\"DeviceClass\",\"namespaced\":false,\"resource\":\"deviceclasses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"traefik.io.ingressrouteudp\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/traefik.io.ingressrouteudps\",\"self\":\"https://harvester.invalid/v1/schemas/traefik.io.ingressrouteudp\"},\"description\":\"IngressRouteUDP is a CRD implementation of a Traefik UDP Router.\",\"pluralName\":\"traefik.io.ingressrouteudps\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"traefik.io\",\"kind\":\"IngressRouteUDP\",\"namespaced\":true,\"resource\":\"ingressrouteudps\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"admissionregistration.k8s.io.validatingadmissionpolicybinding\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/admissionregistration.k8s.io.validatingadmissionpolicybindings\",\"self\":\"https://harvester.invalid/v1/schemas/admissionregistration.k8s.io.validatingadmissionpolicybinding\"},\"description\":\"ValidatingAdmissionPolicyBinding binds the ValidatingAdmissionPolicy with paramerized resources. ValidatingAdmissionPolicyBinding and parameter CRDs together define how cluster administrators configure policies for clusters.\\n\\nFor a given admission request, each binding will cause its policy to be evaluated N times, where N is 1 for policies/bindings that don't use params, otherwise N is the number of parameters selected by the binding.\\n\\nThe CEL expressions of a policy must have a computed CEL cost below the maximum CEL budget. Each evaluation of the policy is given an independent CEL cost budget. Adding/removing policies, bindings, or params can not affect whether a given (policy, binding, param) combination is within its own CEL budget.\",\"pluralName\":\"admissionregistration.k8s.io.validatingadmissionpolicybindings\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"PolicyName\",\"type\":\"string\",\"format\":\"\",\"description\":\"PolicyName indicates the policy definition which the policy binding binded to\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"ParamRef\",\"type\":\"string\",\"format\":\"\",\"description\":\"ParamRef indicates the param resource which sets the configration param\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"group\":\"admissionregistration.k8s.io\",\"kind\":\"ValidatingAdmissionPolicyBinding\",\"namespaced\":false,\"resource\":\"validatingadmissionpolicybindings\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"schema\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/schemas\",\"self\":\"https://harvester.invalid/v1/schemas/schema\"},\"pluralName\":\"schemas\",\"resourceMethods\":[\"GET\"],\"resourceFields\":{\"attributes\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"collectionActions\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"collectionFields\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"collectionFilters\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"collectionMethods\":{\"type\":\"array[string]\",\"create\":false,\"update\":false},\"pluralName\":{\"type\":\"string\",\"create\":false,\"update\":false},\"resourceActions\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"resourceFields\":{\"type\":\"map[json]\",\"create\":false,\"update\":false},\"resourceMethods\":{\"type\":\"array[string]\",\"create\":false,\"update\":false},\"version\":{\"type\":\"map[json]\",\"create\":false,\"update\":false}},\"collectionMethods\":[\"GET\"]},{\"id\":\"autoscaling.horizontalpodautoscaler\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/autoscaling.horizontalpodautoscalers\",\"self\":\"https://harvester.invalid/v1/schemas/autoscaling.horizontalpodautoscaler\"},\"description\":\"HorizontalPodAutoscaler is the configuration for a horizontal pod autoscaler, which automatically manages the replica count of any resource implementing the scale subresource based on the metrics specified.\",\"pluralName\":\"autoscaling.horizontalpodautoscalers\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Reference\",\"type\":\"string\",\"format\":\"\",\"description\":\"scaleTargetRef points to the target resource to scale, and is used to the pods for which metrics should be collected, as well as to actually change the replica count.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Targets\",\"type\":\"string\",\"format\":\"\",\"description\":\"metrics contains the specifications for which to use to calculate the desired replica count (the maximum replica count across all metrics will be used).  The desired replica count is calculated multiplying the ratio between the target value and the current value by the current number of pods.  Ergo, metrics used must decrease as the pod count is increased, and vice-versa.  See the individual metric source types for more information about how each type of metric must respond.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"MinPods\",\"type\":\"string\",\"format\":\"\",\"description\":\"minReplicas is the lower limit for the number of replicas to which the autoscaler can scale down.  It defaults to 1 pod.  minReplicas is allowed to be 0 if the alpha feature gate HPAScaleToZero is enabled and at least one Object or External metric is configured.  Scaling is active as long as at least one metric value is available.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"MaxPods\",\"type\":\"string\",\"format\":\"\",\"description\":\"maxReplicas is the upper limit for the number of replicas to which the autoscaler can scale up. It cannot be less that minReplicas.\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Replicas\",\"type\":\"string\",\"format\":\"\",\"description\":\"currentReplicas is current number of replicas of pods managed by this autoscaler, as last seen by the autoscaler.\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"}],\"group\":\"autoscaling\",\"kind\":\"HorizontalPodAutoscaler\",\"namespaced\":true,\"resource\":\"horizontalpodautoscalers\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v2\"}},{\"id\":\"appsplus.io.appinstance\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/appsplus.io.appinstances\",\"self\":\"https://harvester.invalid/v1/schemas/appsplus.io.appinstance\"},\"pluralName\":\"appsplus.io.appinstances\",\"resourceMethods\":[\"PUT\",\"PATCH\",\"GET\",\"DELETE\"],\"resourceFields\":null,\"collectionMethods\":[\"POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"App\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.app\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Namespace\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.namespace\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Bundle\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.bundleName\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .metadata.creationTimestamp\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"App\":\"{.spec.app}\",\"Bundle\":\"{.status.bundleName}\",\"Name\":\"{.metadata.name}\",\"Namespace\":\"{.spec.namespace}\"},\"group\":\"appsplus.io\",\"kind\":\"AppInstance\",\"namespaced\":false,\"resource\":\"appinstances\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"logging.banzaicloud.io.syslogngclusteroutput\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/logging.banzaicloud.io.syslogngclusteroutputs\",\"self\":\"https://harvester.invalid/v1/schemas/logging.banzaicloud.io.syslogngclusteroutput\"},\"pluralName\":\"logging.banzaicloud.io.syslogngclusteroutputs\",\"resourceMethods\":[\"DELETE\",\"PUT\",\"PATCH\",\"GET\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Active\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"Is the output active?\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Problems\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of problems\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Active\":\"{.status.active}\",\"Name\":\"{.metadata.name}\",\"Problems\":\"{.status.problemsCount}\"},\"group\":\"logging.banzaicloud.io\",\"kind\":\"SyslogNGClusterOutput\",\"namespaced\":true,\"resource\":\"syslogngclusteroutputs\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"count\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/counts\",\"self\":\"https://harvester.invalid/v1/schemas/count\"},\"pluralName\":\"counts\",\"resourceMethods\":[\"GET\"],\"resourceFields\":{\"counts\":{\"type\":\"map[itemCount]\",\"create