ty\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"group\":\"\",\"kind\":\"ConfigMap\",\"namespaced\":true,\"resource\":\"configmaps\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"traefik.io.ingressroutetcp\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/traefik.io.ingressroutetcps\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/traefik.io.ingressroutetcp\"},\"description\":\"IngressRouteTCP is the CRD implementation of a Traefik TCP Router.\",\"pluralName\":\"traefik.io.ingressroutetcps\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"traefik.io\",\"kind\":\"IngressRouteTCP\",\"namespaced\":true,\"resource\":\"ingressroutetcps\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"management.cattle.io.proxyendpoint\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/management.cattle.io.proxyendpoints\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/management.cattle.io.proxyendpoint\"},\"description\":\"ProxyEndpoint defines a set of domains to be added to the Rancher meta proxy allowlist,\\nwhich determines what external domains the proxy is permitted to forward requests to.\\nDomain entries support absolute domain names (e.g., example.com) and wildcard\\npatterns using * (prefix matching) or % (single-segment placeholder).\",\"pluralName\":\"management.cattle.io.proxyendpoints\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"management.cattle.io\",\"kind\":\"ProxyEndpoint\",\"namespaced\":false,\"resource\":\"proxyendpoints\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"storage.k8s.io.csidriver\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/storage.k8s.io.csidrivers\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/storage.k8s.io.csidriver\"},\"description\":\"CSIDriver captures information about a Container Storage Interface (CSI) volume driver deployed on the cluster. Kubernetes attach detach controller uses this object to determine whether attach is required. Kubelet uses this object to determine whether pod information needs to be passed on mount. CSIDriver objects are non-namespaced.\",\"pluralName\":\"storage.k8s.io.csidrivers\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"AttachRequired\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"attachRequired indicates this CSI volume driver requires an attach operation (because it implements the CSI ControllerPublishVolume() method), and that the Kubernetes attach detach controller should call the attach volume interface which checks the volumeattachment status and waits until the volume is attached before proceeding to mounting. The CSI external-attacher coordinates with CSI volume driver and updates the volumeattachment status when the attach operation is complete. If the value is specified to false, the attach operation will be skipped. Otherwise the attach operation will be called.\\n\\nThis field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"PodInfoOnMount\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"podInfoOnMount indicates this CSI volume driver requires additional pod information (like podName, podUID, etc.) during mount operations, if set to true. If set to false, pod information will not be passed on mount. Default is false.\\n\\nThe CSI driver specifies podInfoOnMount as part of driver deployment. If true, Kubelet will pass pod information as VolumeContext in the CSI NodePublishVolume() calls. The CSI driver is responsible for parsing and validating the information passed in as VolumeContext.\\n\\nThe following VolumeContext will be passed if podInfoOnMount is set to true. This list might grow, but the prefix will be used. \\\"csi.storage.k8s.io/pod.name\\\": pod.Name \\\"csi.storage.k8s.io/pod.namespace\\\": pod.Namespace \\\"csi.storage.k8s.io/pod.uid\\\": string(pod.UID) \\\"csi.storage.k8s.io/ephemeral\\\": \\\"true\\\" if the volume is an ephemeral inline volume\\n                                defined by a CSIVolumeSource, otherwise \\\"false\\\"\\n\\n\\\"csi.storage.k8s.io/ephemeral\\\" is a new feature in Kubernetes 1.16. It is only required for drivers which support both the \\\"Persistent\\\" and \\\"Ephemeral\\\" VolumeLifecycleMode. Other drivers can leave pod info disabled and/or ignore this field. As Kubernetes 1.15 doesn't support this field, drivers can only support one mode when deployed on such a cluster and the deployment determines which mode that is, for example via a command line parameter of the driver.\\n\\nThis field was immutable in Kubernetes < 1.29 and now is mutable.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"StorageCapacity\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"storageCapacity indicates that the CSI volume driver wants pod scheduling to consider the storage capacity that the driver deployment will report by creating CSIStorageCapacity objects with capacity information, if set to true.\\n\\nThe check can be enabled immediately when deploying a driver. In that case, provisioning new volumes with late binding will pause until the driver deployment has published some suitable CSIStorageCapacity object.\\n\\nAlternatively, the driver can be deployed with the field unset or false and it can be flipped later when storage capacity information has been published.\\n\\nThis field was immutable in Kubernetes <= 1.22 and now is mutable.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"TokenRequests\",\"type\":\"string\",\"format\":\"\",\"description\":\"tokenRequests indicates the CSI driver needs pods' service account tokens it is mounting volume for to do necessary authentication. Kubelet will pass the tokens in VolumeContext in the CSI NodePublishVolume calls. The CSI driver should parse and validate the following VolumeContext: \\\"csi.storage.k8s.io/serviceAccount.tokens\\\": {\\n  \\\"<audience>\\\": {\\n    \\\"token\\\": <token>,\\n    \\\"expirationTimestamp\\\": <expiration timestamp in RFC3339>,\\n  },\\n  ...\\n}\\n\\nNote: Audience in each TokenRequest should be different and at most one token is empty string. To receive a new token after expiry, RequiresRepublish can be used to trigger NodePublishVolume periodically.\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"RequiresRepublish\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"requiresRepublish indicates the CSI driver wants `NodePublishVolume` being periodically called to reflect any possible change in the mounted volume. This field defaults to false.\\n\\nNote: After a successful initial NodePublishVolume call, subsequent calls to NodePublishVolume should only update the contents of the volume. New mount points will not be seen by a running container.\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Modes\",\"type\":\"string\",\"format\":\"\",\"description\":\"volumeLifecycleModes defines what kind of volumes this CSI volume driver supports. The default if the list is empty is \\\"Persistent\\\", which is the usage defined by the CSI specification and implemented in Kubernetes via the usual PV/PVC mechanism.\\n\\nThe other mode is \\\"Ephemeral\\\". In this mode, volumes are defined inline inside the pod spec with CSIVolumeSource and their lifecycle is tied to the lifecycle of that pod. A driver has to be aware of this because it is only going to get a NodePublishVolume call for such a volume.\\n\\nFor more information about implementing this mode, see https://kubernetes-csi.github.io/docs/ephemeral-local-volumes.html A driver can support one or more of these modes and more modes may be added in the future.\\n\\nThis field is beta. This field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[7]\"}],\"group\":\"storage.k8s.io\",\"kind\":\"CSIDriver\",\"namespaced\":false,\"resource\":\"csidrivers\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"addons.cluster.x-k8s.io.clusterresourceset\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/addons.cluster.x-k8s.io.clusterresourcesets\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/addons.cluster.x-k8s.io.clusterresourceset\"},\"description\":\"ClusterResourceSet is the Schema for the clusterresourcesets API.\\nFor advanced use cases an add-on provider should be used instead.\",\"pluralName\":\"addons.cluster.x-k8s.io.clusterresourcesets\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Applied\",\"field\":\".status.conditions[?(@.type==\\\"ResourcesApplied\\\")].status\",\"type\":\"string\"},{\"name\":\"Paused\",\"field\":\".status.conditions[?(@.type==\\\"Paused\\\")].status\",\"type\":\"string\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"addons.cluster.x-k8s.io\",\"hasObservedGeneration\":true,\"kind\":\"ClusterResourceSet\",\"namespaced\":true,\"resource\":\"clusterresourcesets\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"whereabouts.cni.cncf.io.overlappingrangeipreservation\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/whereabouts.cni.cncf.io.overlappingrangeipreservations\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/whereabouts.cni.cncf.io.overlappingrangeipreservation\"},\"description\":\"OverlappingRangeIPReservation is the Schema for the OverlappingRangeIPReservations API\",\"pluralName\":\"whereabouts.cni.cncf.io.overlappingrangeipreservations\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"whereabouts.cni.cncf.io\",\"kind\":\"OverlappingRangeIPReservation\",\"namespaced\":true,\"resource\":\"overlappingrangeipreservations\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"networking.k8s.io.networkpolicy\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/networking.k8s.io.networkpolicies\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/networking.k8s.io.networkpolicy\"},\"description\":\"NetworkPolicy describes what network traffic is allowed for a set of Pods\",\"pluralName\":\"networking.k8s.io.networkpolicies\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Pod-Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"podSelector selects the pods to which this NetworkPolicy object applies. The array of rules is applied to any pods selected by this field. An empty selector matches all pods in the policy's namespace. Multiple network policies can select the same set of pods. In this case, the ingress rules for each are combined additively. This field is optional. If it is not specified, it defaults to an empty selector.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"NetworkPolicy\",\"namespaced\":true,\"resource\":\"networkpolicies\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"componentstatus\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/componentstatuses\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/componentstatus\"},\"description\":\"ComponentStatus (and ComponentStatusList) holds the cluster validation info. Deprecated: This API is deprecated in v1.19+\",\"pluralName\":\"componentstatuses\",\"resourceMethods\":[\"GET\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Status\",\"type\":\"string\",\"format\":\"\",\"description\":\"Status of the component conditions\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Message\",\"type\":\"string\",\"format\":\"\",\"description\":\"Message of the component conditions\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Error\",\"type\":\"string\",\"format\":\"\",\"description\":\"Error of the component conditions\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"group\":\"\",\"kind\":\"ComponentStatus\",\"namespaced\":false,\"resource\":\"componentstatuses\",\"verbs\":[\"get\",\"list\"],\"version\":\"v1\"}},{\"id\":\"networking.k8s.io.ingress\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/networking.k8s.io.ingresses\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/networking.k8s.io.ingress\"},\"description\":\"Ingress is a collection of rules that allow inbound connections to reach the endpoints defined by a backend. An Ingress can be configured to give services externally-reachable urls, load balance traffic, terminate SSL, offer name based virtual hosting etc.\",\"pluralName\":\"networking.k8s.io.ingresses\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Class\",\"type\":\"string\",\"format\":\"\",\"description\":\"The name of the IngressClass resource that should be used for additional configuration\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Hosts\",\"type\":\"string\",\"format\":\"\",\"description\":\"Hosts that incoming requests are matched against before the ingress rule\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Address\",\"type\":\"string\",\"format\":\"\",\"description\":\"Address is a list containing ingress points for the load-balancer\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Ports\",\"type\":\"string\",\"format\":\"\",\"description\":\"Ports of TLS configurations that open\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"Ingress\",\"namespaced\":true,\"resource\":\"ingresses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"hub.traefik.io.managedsubscription\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/hub.traefik.io.managedsubscriptions\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/hub.traefik.io.managedsubscription\"},\"description\":\"ManagedSubscription defines a Subscription managed by the API manager as the result of a pre-negotiation with its\\nAPI consumers. This subscription grant consuming access to a set of APIs to a set of Applications.\",\"pluralName\":\"hub.traefik.io.managedsubscriptions\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overv