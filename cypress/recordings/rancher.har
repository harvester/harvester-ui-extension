ommunity/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"group\":\"coordination.k8s.io\",\"kind\":\"Lease\",\"namespaced\":true,\"resource\":\"leases\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"cert-manager.io.certificaterequest\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/cert-manager.io.certificaterequests\",\"self\":\"https://harvester.invalid/v1/schemas/cert-manager.io.certificaterequest\"},\"description\":\"A CertificateRequest is used to request a signed certificate from one of the configured issuers. \\n All fields within the CertificateRequest's `spec` are immutable after creation. A CertificateRequest will either succeed or fail, as denoted by its `Ready` status condition and its `status.failureTime` field. \\n A CertificateRequest is a one-shot resource, meaning it represents a single point in time request for a certificate and cannot be re-used.\",\"pluralName\":\"cert-manager.io.certificaterequests\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Approved\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type==\\\"Approved\\\")].status\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Denied\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type==\\\"Denied\\\")].status\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Ready\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type==\\\"Ready\\\")].status\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Issuer\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.issuerRef.name\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Requestor\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.username\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Status\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type==\\\"Ready\\\")].message\",\"priority\":1,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\",\"priority\":0,\"field\":\"$.metadata.fields[7]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Approved\":\"{.status.conditions[?(@.type==\\\"Approved\\\")].status}\",\"Denied\":\"{.status.conditions[?(@.type==\\\"Denied\\\")].status}\",\"Issuer\":\"{.spec.issuerRef.name}\",\"Name\":\"{.metadata.name}\",\"Ready\":\"{.status.conditions[?(@.type==\\\"Ready\\\")].status}\",\"Requestor\":\"{.spec.username}\",\"Status\":\"{.status.conditions[?(@.type==\\\"Ready\\\")].message}\"},\"group\":\"cert-manager.io\",\"kind\":\"CertificateRequest\",\"namespaced\":true,\"resource\":\"certificaterequests\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"cluster.x-k8s.io.machinehealthcheck\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/cluster.x-k8s.io.machinehealthchecks\",\"self\":\"https://harvester.invalid/v1/schemas/cluster.x-k8s.io.machinehealthcheck\"},\"description\":\"MachineHealthCheck is the Schema for the machinehealthchecks API.\",\"pluralName\":\"cluster.x-k8s.io.machinehealthchecks\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Cluster\",\"type\":\"string\",\"format\":\"\",\"description\":\"Cluster\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Replicas\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of machines currently monitored\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Healthy\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Current observed healthy machines\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Paused\",\"type\":\"string\",\"format\":\"\",\"description\":\"Reconciliation paused\",\"priority\":10,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Time duration since creation of MachineHealthCheck\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Cluster\":\"{.spec.clusterName}\",\"Healthy\":\"{.status.currentHealthy}\",\"Name\":\"{.metadata.name}\",\"Paused\":\"{.status.conditions[?(@.type==\\\"Paused\\\")].status}\",\"Replicas\":\"{.status.expectedMachines}\"},\"group\":\"cluster.x-k8s.io\",\"hasObservedGeneration\":true,\"kind\":\"MachineHealthCheck\",\"namespaced\":true,\"resource\":\"machinehealthchecks\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"upgrade.cattle.io.plan\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/upgrade.cattle.io.plans\",\"self\":\"https://harvester.invalid/v1/schemas/upgrade.cattle.io.plan\"},\"description\":\"Plan represents a set of Jobs to apply an upgrade (or other operation) to set of Nodes.\",\"pluralName\":\"upgrade.cattle.io.plans\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Image\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.upgrade.image\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Channel\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath 