"dynamicField\":true,\"type\":\"string\",\"update\":true},\"cloudinit\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere cloud-init filepath or url to add to guestinfo, filepath will be read and base64 encoded before adding\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"contentLibrary\":{\"create\":true,\"default\":\"\",\"description\":\"If you choose to clone from a content library template specify the name of the library\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"cpuCount\":{\"create\":true,\"default\":\"2\",\"description\":\"vSphere CPU number for docker VM\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"creationType\":{\"create\":true,\"default\":\"legacy\",\"description\":\"Creation type when creating a new virtual machine. Supported values: vm, template, library, legacy\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"customAttribute\":{\"create\":true,\"description\":\"vSphere custom attribute, format key/value e.g. '200=my custom value'\",\"dynamicField\":true,\"nullable\":true,\"type\":\"array[string]\",\"update\":true},\"datacenter\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere datacenter for virtual machine\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"datastore\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere datastore for virtual machine\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"datastoreCluster\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere datastore cluster for virtual machine\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"diskSize\":{\"create\":true,\"default\":\"20480\",\"description\":\"vSphere size of disk for docker VM (in MB)\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"folder\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere folder for the docker VM. This folder must already exist in the datacenter\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"gracefulShutdownTimeout\":{\"create\":true,\"default\":\"0\",\"description\":\"How many seconds to wait before timing out when attempting a graceful shutdown for a vSphere virtual machine. A force destroy will perform when the value is zero.\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"hostsystem\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere compute resource where the docker VM will be instantiated. This can be omitted if using a cluster with DRS\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"memorySize\":{\"create\":true,\"default\":\"2048\",\"description\":\"vSphere size of memory for docker VM (in MB)\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"network\":{\"create\":true,\"description\":\"vSphere network where the virtual machine will be attached\",\"dynamicField\":true,\"nullable\":true,\"type\":\"array[string]\",\"update\":true},\"os\":{\"create\":true,\"default\":\"linux\",\"description\":\"If using a non-B2D image you can specify the desired machine OS\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"password\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere password\",\"dynamicField\":true,\"type\":\"password\",\"update\":true},\"pool\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere resource pool for docker VM\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"sshPassword\":{\"create\":true,\"default\":\"tcuser\",\"description\":\"If using a non-B2D image you can specify the ssh password\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"sshPort\":{\"create\":true,\"default\":\"22\",\"description\":\"If using a non-B2D image you can specify the ssh port\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"sshUser\":{\"create\":true,\"default\":\"docker\",\"description\":\"If using a non-B2D image you can specify the ssh user\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"sshUserGroup\":{\"create\":true,\"default\":\"staff\",\"description\":\"If using a non-B2D image the uploaded keys will need chown'ed, defaults to staff e.g. docker:staff\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"tag\":{\"create\":true,\"description\":\"vSphere tag id e.g. urn:xxx\",\"dynamicField\":true,\"nullable\":true,\"type\":\"array[string]\",\"update\":true},\"username\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere username\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"vappIpallocationpolicy\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere vApp IP allocation policy. Supported values are: dhcp, fixed, transient and fixedAllocated\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"vappIpprotocol\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere vApp IP protocol for this deployment. Supported values are: IPv4 and IPv6\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"vappProperty\":{\"create\":true,\"description\":\"vSphere vApp properties\",\"dynamicField\":true,\"nullable\":true,\"type\":\"array[string]\",\"update\":true},\"vappTransport\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere OVF environment transports to use for properties. Supported values are: iso and com.vmware.guestInfo\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"vcenter\":{\"create\":true,\"default\":\"\",\"description\":\"vSphere IP/hostname for vCenter\",\"dynamicField\":true,\"type\":\"string\",\"update\":true},\"vcenterPort\":{\"create\":true,\"default\":\"443\",\"description\":\"vSphere Port for vCenter\",\"dynamicField\":true,\"type\":\"string\",\"update\":true}},\"type\":\"schema\",\"version\":{\"group\":\"management.cattle.io\",\"path\":\"/v3\",\"version\":\"v3\"}},{\"baseType\":\"schema\",\"id\":\"vmwarevspherecredentialconfig\",\"links\":{\"self\":\"https://harvester.invalid/v3/schemas/vmwarevspherecredentialconfig\"},\"pluralName\":\"vmwarevspherecredentialconfigs\",