E\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Clusters-Ready\",\"field\":\".status.display.readyClusters\",\"type\":\"string\"},{\"name\":\"Bundles-Ready\",\"field\":\".status.display.readyBundles\",\"type\":\"string\"},{\"name\":\"Status\",\"field\":\".status.conditions[?(@.type==\\\"Ready\\\")].message\",\"type\":\"string\"}],\"crd\":true,\"group\":\"fleet.cattle.io\",\"kind\":\"ClusterGroup\",\"namespaced\":true,\"resource\":\"clustergroups\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"hub.traefik.io.apiratelimit\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/hub.traefik.io.apiratelimits\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/hub.traefik.io.apiratelimit\"},\"description\":\"APIRateLimit defines how group of consumers are rate limited on a set of APIs.\",\"pluralName\":\"hub.traefik.io.apiratelimits\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"hub.traefik.io\",\"kind\":\"APIRateLimit\",\"namespaced\":true,\"resource\":\"apiratelimits\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"persistentvolume\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/persistentvolumes\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/persistentvolume\"},\"description\":\"PersistentVolume (PV) is a storage resource provisioned by an administrator. It is analogous to a node. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes\",\"pluralName\":\"persistentvolumes\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Capacity\",\"type\":\"string\",\"format\":\"\",\"description\":\"capacity is the description of the persistent volume's resources and capacity. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#capacity\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Access Modes\",\"type\":\"string\",\"format\":\"\",\"description\":\"accessModes contains all ways the volume can be mounted. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#access-modes\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Reclaim Policy\",\"type\":\"string\",\"format\":\"\",\"description\":\"persistentVolumeReclaimPolicy defines what happens to a persistent volume when released from its claim. Valid options are Retain (default for manually created PersistentVolumes), Delete (default for dynamically provisioned PersistentVolumes), and Recycle (deprecated). Recycle must be supported by the volume plugin underlying this PersistentVolume. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#reclaiming\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Status\",\"type\":\"string\",\"format\":\"\",\"description\":\"phase indicates if a volume is available, bound to a claim, or released by a claim. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#phase\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Claim\",\"type\":\"string\",\"format\":\"\",\"description\":\"claimRef is part of a bi-directional binding between PersistentVolume and PersistentVolumeClaim. Expected to be non-nil when bound. claim.VolumeName is the authoritative bind between PV and PVC. More info: https://kubernetes.io/docs/concepts/storage/persistent-volumes#binding\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"StorageClass\",\"type\":\"string\",\"format\":\"\",\"description\":\"StorageClass of the pv\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"VolumeAttributesClass\",\"type\":\"string\",\"format\":\"\",\"description\":\"VolumeAttributesClass of the pv\",\"priority\":0,\"field\":\"$.metadata.fields[7]\"},{\"name\":\"Reason\",\"type\":\"string\",\"format\":\"\",\"description\":\"reason is a brief CamelCase string that describes any failure and is meant for machine parsing and tidy display in the CLI.\",\"priority\":0,\"field\":\"$.metadata.fields[8]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[9]\"},{\"name\":\"VolumeMode\",\"type\":\"string\",\"format\":\"\",\"description\":\"volumeMode defines if a volume is intended to be used with a formatted filesystem or to remain in raw block state. Value of Filesystem is implied when not included in spec.\",\"priority\":1,\"field\":\"$.metadata.fields[10]\"}],\"group\":\"\",\"kind\":\"PersistentVolume\",\"namespaced\":false,\"resource\":\"persistentvolumes\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"kubeovn.io.ip\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/kubeovn.io.ips\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/kubeovn.io.ip\"},\"pluralName\":\"kubeovn.io.ips\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"V4IP\",\"field\":\".spec.v4IpAddress\",\"type\":\"string\"},{\"name\":\"V6IP\",\"field\":\".spec.v6IpAddress\",\"type\":\"string\"},{\"name\":\"Mac\",\"field\":\".spec.macAddress\",\"type\":\"string\"},{\"name\":\"Node\",\"field\":\".spec.nodeName\",\"type\":\"string\"},{\"name\":\"Subnet\",\"field\":\".spec.subnet\",\"type