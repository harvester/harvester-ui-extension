s[1]\"},{\"name\":\"Problems\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of problems\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Active\":\"{.status.active}\",\"Name\":\"{.metadata.name}\",\"Problems\":\"{.status.problemsCount}\"},\"group\":\"logging.banzaicloud.io\",\"kind\":\"ClusterFlow\",\"namespaced\":true,\"resource\":\"clusterflows\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"networking.k8s.io.servicecidr\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/networking.k8s.io.servicecidrs\",\"self\":\"https://harvester.invalid/v1/schemas/networking.k8s.io.servicecidr\"},\"description\":\"ServiceCIDR defines a range of IP addresses using CIDR format (e.g. 198.51.100.3/24 or 2001:db2::/64). This range is used to allocate ClusterIPs to Service objects.\",\"pluralName\":\"networking.k8s.io.servicecidrs\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"CIDRs\",\"type\":\"string\",\"format\":\"\",\"description\":\"CIDRs defines the IP blocks in CIDR notation (e.g. \\\"198.51.100.3/24\\\" or \\\"2001:db8::/64\\\") from which to assign service cluster IPs. Max of two CIDRs is allowed, one of each IP family. This field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"ServiceCIDR\",\"namespaced\":false,\"resource\":\"servicecidrs\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"fleet.cattle.io.policy\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/fleet.cattle.io.policies\",\"self\":\"https://harvester.invalid/v1/schemas/fleet.cattle.io.policy\"},\"description\":\"Policy restricts what GitRepo, HelmOp, and Bundle resources in the same\\nnamespace may do. Enforced at three points in the controller stack:\\n\\n  - GitRepo reconciler: validates and applies defaults before producing a Bundle.\\n  - HelmOp reconciler: validates and applies defaults before producing a Bundle.\\n  - Bundle reconciler: validates only (fail-only) before producing BundleDeployments.\\n\\nTop-level fields are checked by all three reconcilers.\\nSub-object fields (gitRepo, helmOp) are only read by their respective reconciler.\\nDefault* fields inside sub-objects are applied before top-level validators run.\\n\\nMultiple Policy objects in the same namespace are aggregated with OR/union\\nsemantics, sorted by name for determinism.\",\"pluralName\":\"fleet.cattle.io.policies\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"s