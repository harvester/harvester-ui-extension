vider ID\",\"priority\":10,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Failure domain\",\"type\":\"string\",\"format\":\"\",\"description\":\"The failure domain where the Machine has been scheduled\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Ready\",\"type\":\"string\",\"format\":\"\",\"description\":\"Machine pass all readiness checks\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Available\",\"type\":\"string\",\"format\":\"\",\"description\":\"Machine is Ready for at least MinReadySeconds\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Up-to-date\",\"type\":\"string\",\"format\":\"\",\"description\":\" Machine spec matches the spec of the Machine's owner resource, e.g. MachineDeployment\",\"priority\":0,\"field\":\"$.metadata.fields[7]\"},{\"name\":\"Internal-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"Internal IP of the machine\",\"priority\":10,\"field\":\"$.metadata.fields[8]\"},{\"name\":\"External-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"External IP of the machine\",\"priority\":10,\"field\":\"$.metadata.fields[9]\"},{\"name\":\"OS-Image\",\"type\":\"string\",\"format\":\"\",\"description\":\"OS Image reported by the node\",\"priority\":10,\"field\":\"$.metadata.fields[10]\"},{\"name\":\"Paused\",\"type\":\"string\",\"format\":\"\",\"description\":\"Reconciliation paused\",\"priority\":10,\"field\":\"$.metadata.fields[11]\"},{\"name\":\"Phase\",\"type\":\"string\",\"format\":\"\",\"description\":\"Machine status such as Terminating/Pending/Running/Failed etc\",\"priority\":0,\"field\":\"$.metadata.fields[12]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Time duration since creation of Machine\",\"priority\":0,\"field\":\"$.metadata.fields[13]\"},{\"name\":\"Version\",\"type\":\"string\",\"format\":\"\",\"description\":\"Kubernetes version associated with this Machine\",\"priority\":0,\"field\":\"$.metadata.fields[14]\"}],\"crd\":true,\"crdJ