\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"hub.traefik.io\",\"kind\":\"AIService\",\"namespaced\":true,\"resource\":\"aiservices\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"management.cattle.io.apiservice\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/management.cattle.io.apiservices\",\"self\":\"https://harvester.invalid/v1/schemas/management.cattle.io.apiservice\"},\"pluralName\":\"management.cattle.io.apiservices\",\"resourceMethods\":[\"blocked-PUT\",\"blocked-PATCH\",\"GET\",\"blocked-DELETE\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"blocked-POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"disallowMethods\":{\"DELETE\":true,\"PATCH\":true,\"POST\":true,\"PUT\":true},\"group\":\"management.cattle.io\",\"kind\":\"APIService\",\"namespaced\":false,\"resource\":\"apiservices\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"logging.banzaicloud.io.syslogngoutput\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/logging.banzaicloud.io.syslogngoutputs\",\"self\":\"https://harvester.invalid/v1/schemas/logging.banzaicloud.io.syslogngoutput\"},\"pluralName\":\"logging.banzaicloud.io.syslogngoutputs\",\"resourceMethods\":[\"PUT\",\"PATCH\",\"GET\",\"DELETE\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Active\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"Is the output active?\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Problems\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of problems\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Active\":\"{.status.active}\",\"Name\":\"{.metadata.name}\",\"Problems\":\"{.status.problemsCount}\"},\"group\":\"logging.banzaicloud.io\",\"kind\":\"SyslogNGOutput\",\"namespaced\":true,\"resource\":\"syslogngoutputs\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"management.cattle.io.samltoken\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/management.cattle.io.samltokens\",\"self\":\"https://harvester.invalid/v1/schemas/management.cattle.io.samltoken\"},\"pluralName\":\"management.cattle.io.samltokens\",\"resourceMethods\":[\"GET\",\"blocked-DELETE\",\"blocked-PUT\",\"blocked-PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"blocked-POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"disallowMethods\":{\"DELETE\":true,\"PATCH\":true,\"POST\":true,\"PUT\":true},\"group\":\"management.cattle.io\",\"kind\":\"SamlToken\",\"namespaced\":true,\"resource\":\"samltokens\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"resource.k8s.io.resourceslice\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/resource.k8s.io.resourceslices\",\"self\":\"https://harvester.invalid/v1/schemas/resource.k8s.io.resourceslice\"},\"description\":\"ResourceSlice represents one or more resources in a pool of similar resources, managed by a common driver. A pool may span more than one ResourceSlice, and exactly how many ResourceSlices comprise a pool is determined by the driver.\\n\\nAt the moment, the only supported resources are devices with attributes and capacities. Each device in a given pool, regardless of how many ResourceSlices, must have a unique name. The ResourceSlice in which a device gets published may change over time. The unique identifier for a device is the tuple <driver name>, <pool name>, <device name>.\\n\\nWhenever a driver needs to update a pool, it increments the pool.Spec.Pool.Generation number and updates all ResourceSlices with that new number and new resource definitions. A consumer must only use ResourceSlices with the highest generation number and ignore all others.\\n\\nWhen allocating all resources in a pool matching certain criteria or when looking for the best solution among several different alternatives, a consumer should check the number of ResourceSlices in a pool (included in each ResourceSlice) to determine whether its view of a pool is complete and if not, should wait until the driver has completed updating the pool.\\n\\nFor resources that are not local to a node, the node name is not set. Instead, the driver may use a node selector to specify where the devices are available.\\n\\nThis is an alpha type and requires enabling the DynamicResourceAllocation feature gate.\",\"pluralName\":\"resource.k8s.io.resourceslices\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Node\",\"type\":\"string\",\"format\":\"\",\"description\":\"NodeName identifies the node which provides the resources in this pool. A field selector can be used to list only ResourceSlice objects belonging to a certain node.\\n\\nThis field can be used to limit access from nodes to ResourceSlices with the same node name. It also indicates to autoscalers that adding new nodes of the same type as some old node might also make new resources available.\\n\\nExactly one of NodeName, NodeSelector, AllNodes, and PerDeviceNodeSelection must be set. This field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Driver\",\"type\":\"string\",\"format\":\"\",\"description\":\"Driver identifies the DRA driver providing the capacity information. A field selector can be used to list only ResourceSlice objects with a certain driver name.\\n\\nMust be a DNS subdomain and should end with a DNS domain owned by the vendor of the driver. This field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Pool\",\"type\":\"string\",\"format\":\"\",\"description\":\"Name is used to identify the pool. For node-local devices, this is often the node name, but this is not required.\\n\\nIt must not be longer than 253 characters and must consist of one or more DNS sub-domains separated by slashes. This field is immutable.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"}],\"group\":\"resource.k8s.io\",\"kind\":\"ResourceSlice\",\"namespaced\":false,\"resource\":\"resourceslices\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"rbac.authorization.k8s.io.rolebinding\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/rbac.authorization.k8s.io.rolebindings\",\"self\":\"https://harvester.invalid/v1/schemas/rbac.authorization.k8s.io.rolebinding\"},\"description\":\"RoleBinding references a role, but does not contain it.  It can reference a Role in the same namespace or a ClusterRole in the global namespace. It adds who information via Subjects and namespace information by which namespace it exists in.  RoleBindings in a given namespace only have effect in that namespace.\",\"pluralName\":\"rbac.authorization.k8s.io.rolebindings\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Role\",\"type\":\"string\",\"format\":\"\",\"description\":\"RoleRef can reference a Role in the current namespace or a ClusterRole in the global namespace. If the RoleRef cannot be resolved, the Authorizer must return an error.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Users\",\"type\":\"string\",\"format\":\"\",\"description\":\"Users in the roleBinding\",\"priority\":1,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Groups\",\"type\":\"string\",\"format\":\"\",\"description\":\"Groups in the roleBinding\",\"priority\":1,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"ServiceAccounts\",\"type\":\"string\",\"format\":\"\",\"description\":\"ServiceAccounts in the roleBinding\",\"priority\":1,\"field\":\"$.metadata.fields[5]\"}],\"group\":\"rbac.authorization.k8s.io\",\"kind\":\"RoleBinding\",\"namespaced\":true,\"resource\":\"rolebindings\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"fleet.cattle.io.clustergroup\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/fleet.cattle.io.clustergroups\",\"self\":\"https://harvester.invalid/v1/schemas/fleet.cattle.io.clustergroup\"},\"description\":\"ClusterGroup is a re-usable selector to target a group of clusters.\",\"pluralName\":\"fleet.cattle.io.clustergroups\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Clusters-Ready\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.display.readyClusters\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Bundles-Ready\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.display.readyBundles\",\"priority\":0,\"field\":\"$.met