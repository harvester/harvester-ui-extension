the representation defined by RFC 5952 for IPv6. Valid: 198.51.100.7 or 2001:db8::1 or 2001:db8:aaaa:bbbb:cccc:dddd:eeee:1 Invalid: 198.51.100.8 or 2001:db8:0:0:0::1\",\"pluralName\":\"networking.k8s.io.ipaddresses\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"ParentRef\",\"type\":\"string\",\"format\":\"\",\"description\":\"ParentRef references the resource that an IPAddress is attached to. An IPAddress must reference a parent object.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"IPAddress\",\"namespaced\":false,\"resource\":\"ipaddresses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"longhorn.io.engine\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/longhorn.io.engines\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/longhorn.io.engine\"},\"description\":\"Engine is where Longhorn stores engine object.\",\"pluralName\":\"longhorn.io.engines\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Data Engine\",\"field\":\".spec.dataEngine\",\"type\":\"string\"},{\"name\":\"State\",\"field\":\".