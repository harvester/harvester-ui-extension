portal.\",\"pluralName\":\"hub.traefik.io.apicatalogitems\",\"resourceMethods\":[\"DELETE\",\"PUT\",\"PATCH\",\"GET\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"hub.traefik.io\",\"kind\":\"APICatalogItem\",\"namespaced\":true,\"resource\":\"apicatalogitems\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"authorization.k8s.io.localsubjectaccessreview\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/authorization.k8s.io.localsubjectaccessreviews\",\"self\":\"https://harvester.invalid/v1/schemas/authorization.k8s.io.localsubjectaccessreview\"},\"description\":\"LocalSubjectAccessReview checks whether or not a user or group can perform an action in a given namespace. Having a namespace scoped resource makes it much easier to grant namespace scoped policy that includes permissions checking.\",\"pluralName\":\"authorization.k8s.io.localsubjectaccessreviews\",\"resourceFields\":null,\"collectionMethods\":[\"POST\"],\"attributes\":{\"group\":\"authorization.k8s.io\",\"kind\":\"LocalSubjectAccessReview\",\"namespaced\":true,\"resource\":\"localsubjectaccessreviews\",\"verbs\":[\"create\"],\"version\":\"v1\"}},{\"id\":\"auditlog.cattle.io.auditpolicy\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/auditlog.cattle.io.auditpolicies\",\"self\":\"https://harvester.invalid/v1/schemas/auditlog.cattle.io.auditpolicy\"},\"pluralName\":\"auditlog.cattle.io.auditpolicies\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Enabled\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.enabled\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Active\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type == \\\"Active\\\")].status\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Valid\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.conditions[?(@.type == \\\"Valid\\\")].status\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Active\":\"{.status.conditions[?(@.type == \\\"Active\\\")].status}\",\"Enabled\":\"{.spec.enabled}\",\"Name\":\"{.metadata.name}\",\"Valid\":\"{.status.conditions[?(@.type == \\\"Valid\\\")].status}\"},\"group\":\"auditlog.cattle.io\",\"kind\":\"AuditPolicy\",\"namespaced\":false,\"resource\":\"auditpolicies\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"service\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/services\",\"self\":\"https://harvester.invalid/v1/schemas/service\"},\"description\":\"Service is a named abstraction of software service (for example, mysql) consisting of local port (for example 3306) that the proxy listens on, and the selector that determines which pods will answer requests sent through the proxy.\",\"pluralName\":\"services\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Type\",\"type\":\"string\",\"format\":\"\",\"description\":\"type determines how the Service is exposed. Defaults to ClusterIP. Valid options are ExternalName, ClusterIP, NodePort, and LoadBalancer. \\\"ClusterIP\\\" allocates a cluster-internal IP address for load-balancing to endpoints. Endpoints are determined by the selector or if that is not specified, by manual construction of an Endpoints object or EndpointSlice objects. If clusterIP is \\\"None\\\", no virtual IP is allocated and the endpoints are published as a set of endpoints rather than a virtual IP. \\\"NodePort\\\" builds on ClusterIP and allocates a port on every node which routes to the same endpoints as the clusterIP. \\\"LoadBalancer\\\" builds on NodePort and creates an external load-balancer (if supported in the current cloud) which routes to the same endpoints as the clusterIP. \\\"ExternalName\\\" aliases this service to the specified externalName. Several other fields do not apply to ExternalName services. More info: https://kubernetes.io/docs/concepts/services-networking/service/#publishing-services-service-types\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Cluster-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"clusterIP is the IP address of the service and is usually assigned randomly. If an address is specified manually, is in-range (as per system configuration), and is not in use, it will be allocated to the service; otherwise creation of the service will fail. This field may not be changed through updates unless the type field is also being changed to ExternalName (which requires this field to be blank) or the type field is being changed from ExternalName (in which case this field may optionally be specified, as describe above).  Valid values are \\\"None\\\", empty string (\\\"\\\"), or a valid IP address. Setting this to \\\"None\\\" makes a \\\"headless service\\\" (no virtual IP), which is useful when direct endpoint connections are preferred and proxying is not required.  Only applies to types ClusterIP, NodePort, and LoadBalancer. If this field is specified when creating a Service of type ExternalName, creation will fail. This field will be wiped when updating a Service to type ExternalName. More info: https://kubernetes.io/docs/concepts/services-networking/service/#virtual-ips-and-service-proxies\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"External-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"externalIPs is a list of IP addresses for which nodes in the cluster will also accept traffic for this service.  These IPs are not managed by Kubernetes.  The user is responsible for ensuring that traffic arrives at a node with this IP.  A common example is external load-balancers that are not part of the Kubernetes system.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Port(s)\",\"type\":\"string\",\"format\":\"\",\"description\":\"The list of ports that are exposed by this service. More info: https://kubernetes.io/docs/concepts/services-networking/service/#virtual-ips-and-service-proxies\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"Route service traffic to pods with label keys and values matching this selector. If empty or not present, the service is assumed to have an external process managing its endpoints, which Kubernetes will not modify. Only applies to types ClusterIP, NodePort, and LoadBalancer. Ignored if type is ExternalName. More info: https://kubernetes.io/docs/concepts/services-networking/service/\",\"priority\":1,\"field\":\"$.metadata.fields[6]\"}],\"group\":\"\",\"kind\":\"Service\",\"namespaced\":true,\"resource\":\"services\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"logging.banzaicloud.io.loggingroute\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/logging.banzaicloud.io.loggingroutes\",\"self\":\"https://harvester.invalid/v1/schemas/logging.banzaicloud.io.loggingroute\"},\"pluralName\":\"logging.banzaicloud.io.loggingroutes\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Problems\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of problems\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Notices\",\"type\":\"integer\",\"format\":\"\",\"description\":\"Number of notices\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Name\":\"{.metadata.name}\",\"Notices\":\"{.status.noticesCount}\",\"Problems\":\"{.status.problemsCount}\"},\"group\":\"logging.banzaicloud.io\",\"kind\":\"LoggingRoute\",\"namespaced\":false,\"resource\":\"loggingroutes\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"compliance.cattle.io.clusterscanreport\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/compliance.cattle.io.clusterscanreports\",\"self\":\"https://harvester.invalid/v1/schemas/compliance.cattle.io.clusterscanre