tributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"hub.traefik.io\",\"kind\":\"ManagedSubscription\",\"namespaced\":true,\"resource\":\"managedsubscriptions\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"management.cattle.io.group\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/management.cattle.io.groups\",\"self\":\"https://harvester.invalid/v1/schemas/management.cattle.io.group\"},\"pluralName\":\"management.cattle.io.groups\",\"resourceMethods\":[\"GET\",\"blocked-DELETE\",\"blocked-PUT\",\"blocked-PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"blocked-POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"disallowMethods\":{\"DELETE\":true,\"PATCH\":true,\"POST\":true,\"PUT\":true},\"group\":\"management.cattle.io\",\"kind\":\"Group\",\"namespaced\":false,\"resource\":\"groups\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"hub.traefik.io.apibundle\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/hub.traefik.io.apibundles\",\"self\":\"https://harvester.invalid/v1/schemas/hub.traefik.io.apibundle\"},\"description\":\"APIBundle defines a set of APIs.\",\"pluralName\":\"hub.traefik.io.apibundles\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"hub.traefik.io\",\"kind\":\"APIBundle\",\"namespaced\":true,\"resource\":\"apibundles\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"ext.cattle.io.useractivity\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/ext.cattle.io.useractivities\",\"self\":\"https://harvester.invalid/v1/schemas/ext.cattle.io.useractivity\"},\"description\":\"UserActivity keeps tracks user activity in the UI. If the user doesn't perform certain actions for a while e.g. cursor moved, key pressed, etc., this will lead to the user being logged out of the session.\",\"pluralName\":\"ext.cattle.io.useractivities\",\"resourceMethods\":[\"GET\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\"],\"attributes\":{\"aggregated\":true,\"group\":\"ext.cattle.io\",\"kind\":\"UserActivity\",\"namespaced\":false,\"resource\":\"useractivities\",\"table\":\"false\",\"verbs\":[\"get\",\"patch\",\"update\"],\"version\":\"v1\"}},{\"id\":\"addons.cluster.x-k8s.io.clusterresourceset\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/addons.cluster.x-k8s.io.clusterresourcesets\",\"self\":\"https://harvester.invalid/v1/schemas/addons.cluster.x-k8s.io.clusterresourceset\"},\"description\":\"ClusterResourceSet is the Schema for the clusterresourcesets API.\\nFor advanced use cases an add-on provider should be used instead.\",\"pluralName\":\"addons.cluster.x-k8s.io.clusterresourcesets\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Applied\",\"type\":\"string\",\"format\":\"\",\"description\":\"Resource applied\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Paused\",\"type\":\"string\",\"format\":\"\",\"description\":\"Reconciliation paused\",\"priority\":10,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Time duration since creation of ClusterResourceSet\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Applied\":\"{.status.conditions[?(@.type==\\\"ResourcesApplied\\\")].status}\",\"Name\":\"{.metadata.name}\",\"Paused\":\"{.status.conditions[?(@.type==\\\"Paused\\\")].status}\"},\"group\":\"addons.cluster.x-k8s.io\",\"hasObservedGeneration\":true,\"kind\":\"ClusterResourceSet\",\"namespaced\":true,\"resource\":\"clusterresourcesets\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"management.cattle.io.nodepool\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/management.cattle.io.nodepools\",\"self\":\"https://harvester.invalid/v1/schemas/management.cattle.io.nodepool\"},\"pluralName\":\"management.cattle.io.nodepools\",\"resourceMethods\":[\"GET\",\"blocked-DELETE\",\"blocked-PUT\",\"blocked-PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"blocked-POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"disallowMethods\":{\"DELETE\":true,\"PATCH\":true,\"POST\":true,\"PUT\":true},\"group\":\"management.cattle.io\",\"kind\":\"NodePool\",\"namespaced\":true,\"resource\":\"nodepools\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"batch.cronjob\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/batch.cronjobs\",\"self\":\"https://harvester.invalid/v1/schemas/batch.cronjob\"},\"description\":\"CronJob represents the configuration of a single cron job.\",\"pluralName\":\"batch.cronjobs\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Schedule\",\"type\":\"string\",\"format\":\"\",\"description\":\"The schedule in Cron format, see https://en.wikipedia.org/wiki/Cron.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Timezone\",\"type\":\"string\",\"format\":\"\",\"description\":\"The time zone name for the given schedule, see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones. If not specified, this will default to the time zone of the kube-controller-manager process. The set of valid time zone names and the time zone offset is loaded from the system-wide time zone database by the API server during CronJob validation and the controller manager during execution. If no system-wide time zone database can be found a bundled version of the database is used instead. If the time zone name becomes invalid during the lifetime of a CronJob or due to a change in host configuration, the controller will stop creating new new Jobs and will create a system event with the reason UnknownTimeZone. More information can be found in https://kubernetes.io/docs/concepts/workloads/controllers/cron-jobs/#time-zones\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Suspend\",\"type\":\"boolean\",\"format\":\"\",\"description\":\"This flag tells the controller to suspend subsequent executions, it does not apply to already started executions.  Defaults to false.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Active\",\"type\":\"integer\",\"format\":\"\",\"description\":\"A list of pointers to currently running jobs.\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Last Schedule\",\"type\":\"string\",\"format\":\"\",\"description\":\"Information when was the last time the job was successfully scheduled.\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Containers\",\"type\":\"string\",\"format\":\"\",\"description\":\"Names of each container in the template.\",\"priority\":1,\"field\":\"$.metadata.fields[7]\"},{\"name\":\"Images\",\"type\":\"string\",\"format\":\"\",\"description\":\"Images referenced by each container in the template.\",\"priority\":1,\"field\":\"$.metadata.fields[8]\"},{\"name\":\"Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"A label query over pods that should match the pod count. Normally, the system sets this field for you. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#label-selectors\",\"priority\":1,\"field\":\"$.metadata.fields[9]\"}],\"group\":\"batch\",\"kind\":\"CronJob\",\"namespaced\":true,\"resource\":\"cronjobs\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"gateway.networking.k8s.io.grpcroute\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/gateway.networking.k8s.io.grpcroutes\",\"self\":\"https://harvester.invalid/v1/schemas/gateway.networking.k8s.io.grpcroute\"},\"description\":\"GRPCRoute provides a way to route gRPC requests. This includes the capability\\nto match requests by hostname, gRPC service, gRPC method, or HTTP/2 header.\\nFilters can be used to specify additional processing steps. Backends specify\\nwhere matching requests will be routed.\\n\\nGRPCRoute falls under extended support within the Gateway API. Within the\\nfollowing specification, the word \\\"MUST\\\" indicates that an implementation\\nsupporting GRPCRoute must conform to the indicated requirement, but an\\nimplementation not supporting this route type need not follow the requirement\\nunless explicitly indicated.\\n\\nImplementations supporting `GRPCRoute` with the `HTTPS` `ProtocolType` MUST\\naccept HTTP/2 connections without an initial upgrade from HTTP/1.1, i.e. via\\nALPN. If the implementation does not support this, then it MUST set the\\n\\\"Accepted\\\" condition to \\\"False\\\" for the affected listener with a reason of\\n\\\"UnsupportedProtocol\\\".  Implementations MAY also accept HTTP/2 connections\\nwith an upgrade from HTTP/1.\\n\\nImplementations supporting `GRPCRoute` with the `HTTP` `ProtocolType` MUST\\nsupport HTTP/2 over cleartext TCP (h2c,\\nhttps://www.rfc-editor.org/rfc/rfc7540#section-3.1) without an initial\\nupgrade from HTTP/1.1, i.e. with prior knowledge\\n(https://www.rfc-editor.org/rfc/rfc7540#section-3.4). If the implementation\\ndoes not support this, then it MUST set the \\\"Accepted\\\" condition to \\\"False\\\"\\nfor the affected listener with a reason of \\\"UnsupportedProtocol\\\".\\nImplementations MAY also accept HTTP/2 connections with an upgrade from\\nHTTP/1, i.e. without prior knowledge.\",\"pluralName\":\"gateway.networking.k8s.io.grpcroutes\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Hostnames\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .spec.hostnames\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .metadata.creationTimestamp\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Hostnames\":\"{.spec.hostnames}\",\"Name\":\"{.metadata.name}\"},\"group\":\"gateway.networking.k8s.io\",\"kind\":\"GRPCRoute\",\"namespaced\":true,\"resource\":\"grpcroutes\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"apps.daemonset\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/apps.daemonsets\",\"self\":\"https://harvester.invalid/v1/schemas/apps.daemonset\"},\"description\":\"DaemonSet represents the configuration of a daemon set.\",\"pluralName\":\"apps.daemonsets\",\"resourceMethods\":[\"PUT\",\"PATCH\",\"GET\",\"DELETE\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Desired\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The total number of nodes that should be running the daemon pod (including nodes correctly running the daemon pod). More info: https://kubernetes.io/docs/concepts/workloads/controllers/daemonset/\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Current\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The number of nodes that are running at least 1 daemon pod and are supposed to run the daemon pod. More info: https://kubernetes.io/docs/concepts/workloads/controllers/daemonset/\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Ready\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The number of nodes that should be running the daemon pod and have one or more of the daemon pod running and ready.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Up-to-date\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The total number of nodes that are running updated daemon pod\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Available\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The number of nodes that should be running the daemon pod and have one or more of the daemon pod running and available (ready for at least spec.minReadySeconds)\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Node Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"NodeSelector is a selector which must be true for the pod to fit on a node. Selector which must match a node's labels for the pod to be scheduled on that node. More info: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\