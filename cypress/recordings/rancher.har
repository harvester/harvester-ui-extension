laims\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/devices.harvesterhci.io.usbdeviceclaim\"},\"pluralName\":\"devices.harvesterhci.io.usbdeviceclaims\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Node Name\",\"field\":\".status.nodeName\",\"type\":\"string\"},{\"name\":\"PCI Address\",\"field\":\".status.pciAddress\",\"type\":\"string\"},{\"name\":\"User Name\",\"field\":\".spec.userName\",\"type\":\"string\"}],\"crd\":true,\"group\":\"devices.harvesterhci.io\",\"kind\":\"USBDeviceClaim\",\"namespaced\":false,\"resource\":\"usbdeviceclaims\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"gateway.networking.k8s.io.listenerset\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/gateway.networking.k8s.io.listenersets\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/gateway.networking.k8s.io.listenerset\"},\"description\":\"ListenerSet defines a set of additional listeners to attach to an existing Gateway.\\nThis resource provides a mechanism to merge multiple listeners into a single Gateway.\\n\\nThe parent Gateway must explicitly allow ListenerSet attachment through its\\nAllowedListeners configuration. By default, Gateways do not allow ListenerSet\\nattachment.\\n\\nRoutes can attach to a ListenerSet by specifying it as a parentRef, and can\\noptionally target specific listeners using the sectionName field.\\n\\nPolicy Attachment:\\n- Policies that attach to a ListenerSet apply to all listeners defined in that resource\\n- Policies do not impact listeners in the parent Gateway\\n- Different ListenerSets attached to the same Gateway can have different policies\\n- If an implementation cannot apply a policy to specific listeners, it should reject the policy\\n\\nReferenceGrant Semantics:\\n- ReferenceGrants applied to a Gateway are not inherited by child ListenerSets\\n- ReferenceGrants applied to a ListenerSet do not grant permission to the parent Gateway's listeners\\n- A ListenerSet can reference secrets/backends in its own namespace without a ReferenceGrant\\n\\nGateway Integration:\\n  - The parent Gateway's status will include \\\"AttachedListenerSets\\\"\\n    which is the count of ListenerSets that have successfully attached to a Gateway\\n    A ListenerSet is successfully attached to a Gateway when all the following conditions are met:\\n  - The ListenerSet is selected by the Gateway's AllowedListeners field\\n  - The ListenerSet has a valid ParentRef selecting the Gateway\\n  - The ListenerSet's status has the condition \\\"Accepted: true\\\"\",\"pluralName\":\"gateway.networking.k8s.io.listenersets\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Accepted\",\"field\":\".status.conditions[?(@.type==\\\"Accepted\\\")].status\",\"type\":\"string\"},{\"name\":\"Programmed\",\"field\":\".status.conditions[?(@.type==\\\"Programmed\\\")].status\",\"type\":\"string\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"gateway.networking.k8s.io\",\"kind\":\"ListenerSet\",\"namespaced\":true,\"resource\":\"listenersets\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"networking.k8s.io.ingressclass\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/networking.k8s.io.ingressclasses\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/networking.k8s.io.ingressclass\"},\"description\":\"IngressClass represents the class of the Ingress, referenced by the Ingress Spec. The `ingressclass.kubernetes.io/is-default-class` annotation can be used to indicate that an IngressClass should be considered default. When a single IngressClass resource has this annotation set to true, new Ingress resources without a class specified will be assigned this default class.\",\"pluralName\":\"networking.k8s.io.ingressclasses\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Controller\",\"type\":\"string\",\"format\":\"\",\"description\":\"Controller that is responsible for handling this class\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Parameters\",\"type\":\"string\",\"format\":\"\",\"description\":\"A reference to a resource with additional parameters\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"IngressClass\",\"namespaced\":false,\"resource\":\"ingressclasses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"addons.cluster.x-k8s.io.clusterresourcesetbinding\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/addons.cluster.x-k8s.io.clusterresourcesetbindings\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/addons.cluster.x-k8s.io.clusterresourcesetbinding\"},\"description\":\"ClusterResourceSetBinding lists all matching ClusterResourceSets with the cluster it belongs to.\",\"pluralName\":\"addons.cluster.x-k8s.io.clusterresourcesetbindings\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Cluster\",\"field\":\".spec.clusterName\",\"type\":\"string\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"addons.cluster.x-k8s.io\",\"kind\":\"ClusterResourceSetBinding\",\"namespaced\":true,\"resource\":\"clusterresourcesetbindings\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"restoreSnapshotInput\",\"type\":\"schema\",\"links\":{\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/restoreSnapshotInput\"},\"pluralName\":\"restoreSnapshotInputs\",\"resourceFields\":{\"name\":{\"type\":\"string\",\"create\":true,\"update\":true},\"storageClassName\":{\"type\":\"string\",\"create\":true,\"update\":true}}},{\"id\":\"snapshot.storage.k8s.io.volumesnapshot\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/snapshot.storage.k8s.io.volumesnapshots\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/snapshot.storage.k8s.