to Delete.\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"VolumeBindingMode\",\"type\":\"string\",\"format\":\"\",\"description\":\"volumeBindingMode indicates how PersistentVolumeClaims should be provisioned and bound.  When unset, VolumeBindingImmediate is used. This field is only honored by servers that enable the VolumeScheduling feature.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"AllowVolumeExpansion\",\"type\":\"string\",\"format\":\"\",\"description\":\"allowVolumeExpansion shows whether the storage class allow volume expand.\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"}],\"group\":\"storage.k8s.io\",\"kind\":\"StorageClass\",\"namespaced\":false,\"resource\":\"storageclasses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"hub.traefik.io.managedapplication\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/hub.traefik.io.managedapplications\",\"self\":\"https://harvester.invalid/v1/schemas/hub.traefik.io.managedapplication\"},\"description\":\"ManagedApplication represents a managed application.\",\"pluralName\":\"hub.traefik.io.managedapplications\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"descrip