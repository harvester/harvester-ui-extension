r\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"cdi.kubevirt.io\",\"kind\":\"DataVolume\",\"namespaced\":true,\"resource\":\"datavolumes\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"fleet.cattle.io.gitrepo\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/fleet.cattle.io.gitrepos\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/fleet.cattle.io.gitrepo\"},\"description\":\"GitRepo describes a git repository that is watched by Fleet.\\nThe resource contains the necessary information to deploy the repo, or parts\\nof it, to target clusters.\",\"pluralName\":\"fleet.cattle.io.gitrepos\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Repo\",\"field\":\".spec.repo\",\"type\":\"string\"},{\"name\":\"Commit\",\"field\":\".status.commit\",\"type\":\"string\"},{\"name\":\"BundleDeployments-Ready\",\"field\":\".status.display.readyBundleDeployments\",\"type\":\"string\"},{\"name\":\"Status\",\"field\":\".status.conditions[?(@.type==\\\"Ready\\\")].message\",\"type\":\"string\"}],\"crd\":true,\"group\":\"fleet.cattle.io\",\"hasObservedGeneration\":true,\"kind\":\"GitRepo\",\"namespaced\":true,\"resource\":\"gitrepos\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"metrics.k8s.io.nodemetrics\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/metrics.k8s.io.nodes\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/metrics.k8s.io.nodemetrics\"},\"description\":\"NodeMetrics sets resource usage metrics of a node.\",\"pluralName\":\"metrics.k8s.io.nodes\",\"resourceMethods\":[\"GET\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name of the resource\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"cpu\",\"type\":\"string\",\"format\":\"quantity\",\"description\":\"\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"memory\",\"type\":\"string\",\"format\":\"quantity\",\"description\":\"\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Window\",\"type\":\"string\",\"format\":\"duration\",\"description\":\"\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"}],\"group\":\"metrics.k8s.io\",\"kind\":\"NodeMetrics\",\"namespaced\":false,\"resource\":\"nodes\",\"verbs\":[\"get\",\"list\"],\"version\":\"v1beta1\"}},{\"id\":\"monitoring.coreos.com.prometheusrule\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/monitoring.coreos.com.prometheusrules\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/monitoring.coreos.com.prometheusrule\"},\"description\":\"The `PrometheusRule` custom resource definition (CRD) defines [alerting](https://prometheus.io/docs/prometheus/latest/configuration/alerting_rules/) and [recording](https://prometheus.io/docs/prometheus/latest/configuration/recording_rules/) rules to be evaluated by `Prometheus` or `ThanosRuler` objects.\\n\\n`Prometheus` and `ThanosRuler` objects select `PrometheusRule` objects using label and namespace selectors.\",\"pluralName\":\"monitoring.coreos.com.prometheusrules\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"monitoring.coreos.com\",\"kind\":\"PrometheusRule\",\"namespaced\":true,\"resource\":\"prometheusrules\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"service\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/services\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/service\"},\"description\":\"Service is a named abstraction of software service (for example, mysql) consisting of local port (for example 3306) that the proxy listens on, and the selector that determines which pods will answer requests sent through the proxy.\",\"pluralName\":\"services\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Type\",\"type\":\"string\",\"format\":\"\",\"description\":\"type determines how the Service is exposed. Defaults to ClusterIP. Valid options are ExternalName, ClusterIP, NodePort, and LoadBalancer. \\\"ClusterIP\\\" allocates a cluster-internal IP address for load-balancing to endpoints. Endpoints are determined by the selector or if that is not specified, by manual construction of an Endpoints object or EndpointSlice objects. If clusterIP is \\\"None\\\", no virtual IP is allocated and the endpoints are published as a set of endpoints rather than a virtual IP. \\\"NodePort\\\" builds on ClusterIP and allocates a port on every node which routes to the same endpoints as the clusterIP. \\\"LoadBalancer\\\" builds on NodePort and creates an external load-balancer (if supported in the current cloud) which routes to the same endpoints as the clusterIP. \\\"ExternalName\\\" aliases this service to the specified externalName. Several other fields do not apply to ExternalName services. More info: https://kubernetes.io/docs/concepts/services-networking/service/#publishing-services-service-types\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Cluster-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"clusterIP is the IP address of the service and is usually assigned randomly. If an address is specified manually, is in-range (as per system configuration), and is not in use, it will be allocated to the service; otherwise creation of the service will fail. This field may not be changed through updates unless the type field is also being changed to ExternalName (which requires this field to be blank) or the type field is being changed from ExternalName (in which case this field may optionally be specified, as describe above).  Valid values are \\\"None\\\", empty string (\\\"\\\"), or a valid IP address. Setting this to \\\"None\\\" makes a \\\"headless service\\\" (no virtual IP), which is useful when direct endpoint connections are preferred and proxying is not required.  Only applies to types ClusterIP, NodePort, and LoadBalancer. If this field is specified when creating a Service of type ExternalName, creation will fail. This field will be wiped when updating a Service to type ExternalName. More info: https://kubernetes.io/docs/concepts/services-networking/service/#virtual-ips-and-service-proxies\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"External-IP\",\"type\":\"string\",\"format\":\"\",\"description\":\"externalIPs is a list of IP addresses for which nodes in the cluster will also accept traffic for this service.  These IPs are not managed by Kubernetes.  The user is responsible for ensuring that traffic arrives at a node with this IP.  A common example is external load-balancers that are not part of the Kubernetes system.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Port(s)\",\"type\":\"string\",\"format\":\"\",\"description\":\"The list of ports that are exposed by this service. More info: https://kubernetes.io/docs/concepts/services-networking/service/#virtual-ips-and-service-proxies\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"Route service traffic to pods with label keys and values matching this selector. If empty or not present, the service is assumed to have an external process managing its endpoints, which Kubernetes will not modify. Only applies to types ClusterIP, NodePort, and LoadBalancer. Ignored if type is ExternalName. More info: https://kubernetes.io/docs/concepts/services-networking/service/\",\"priority\":1,\"field\":\"$.metadata.fields[6]\"}],\"group\":\"\",\"kind\":\"Service\",\"namespaced\":true,\"resource\":\"services\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"kubeovn.io.vpcnatgateway\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/kubeovn.io.vpc-nat-gateways\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/kubeovn.io.vpcnatgateway\"},\"description\":\"VpcNatGateway represents a NAT gateway for a VPC, implemented as a StatefulSet Pod.\\n\\nArchitecture note:\\nThe NAT gateway Pod does NOT support hot updates. Any changes to Spec fields (ExternalSubnets,\\nSelector, Tolerations, Affinity, etc.) will trigger a StatefulSet template update,\\nwhich causes the Pod to be recreated via RollingUpdate strategy. This is by design because:\\n 1. Network configuration (routes, iptables rules) is initialized at Pod startup\\n 2. Runtime state (vpc_cidrs, init status) is managed by separate handlers and will be\\n    automatically restored after Pod recreation through the normal reconciliation flow\\n\\nThe only exception is QoSPolicy, which can be updated without Pod restart.\",\"pluralName\":\"kubeovn.io.vpc-nat-gateways\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Vpc\",\"field\":\".spec.vpc\",\"type\":\"string\"},{\"name\":\"Subnet\",\"field\":\".spec.subnet\",\"type\":\"string\"},{\"name\":\"LanIP\",\"field\":\".spec.lanIp\",\"type\":\"string\"}],\"crd\":true,\"group\":\"kubeovn.io\",\"kind\":\"VpcNatGateway\",\"namespaced\":false,\"resource\":\"vpc-nat-gateways\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"hub.traefik.io.apiportal\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/hub.traefik.io.apiportals\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/hub.traefik.io.apiportal\"},\"description\":\"APIPortal defines a developer portal for accessing the documentation of APIs.\",\"pluralName\":\"hub.traefik.io.apiportals\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"hub.traefik.io\",\"kind\":\"APIPortal\",\"namespaced\":true,\"resource\":\"apiportals\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"fleet.cattle.io.cluster\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/fleet.cattle.io.clusters\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/fleet.cattle.io.cluster\"},\"description\":\"Cluster corresponds to a Kubernetes cluster. Fleet deploys bundles to targeted clusters.\\nClusters to which Fleet deploys manifests are referred to as downstream\\nclusters. In the single cluster use case, the Fleet Kubernetes\\ncluster is both the manager and downstream cluster at the same time.\",\"pluralName\":\"fleet.cattle.io.clusters\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Bundles-Ready\",\"field\":\".status.display.readyBundles\",\"type\":\"string\"},{\"name\":\"Last-Seen\",\"field\":\".status.agent.lastSeen\",\"type\":\"string\"},{\"name\":\"Status\",\"field\":\".status.conditions[?(@.type==\\\"Ready\\\")].message\",\"type\":\"string\"}],\"crd\":true,\"group\":\"fleet.cattle.io\",\"kind\":\"Cluster\",\"namespaced\":true,\"resource\":\"clusters\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"helm.cattle.io.helmchart\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/helm.cattle.io.helmcharts\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/helm.cattle.io.helmchart\"},\"description\":\"HelmChart represents configuration and state for the deployment of a Helm chart.\",\"plur