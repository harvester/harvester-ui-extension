schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/networking.k8s.io.ingresses\",\"self\":\"https://harvester.invalid/v1/schemas/networking.k8s.io.ingress\"},\"description\":\"Ingress is a collection of rules that allow inbound connections to reach the endpoints defined by a backend. An Ingress can be configured to give services externally-reachable urls, load balance traffic, terminate SSL, offer name based virtual hosting etc.\",\"pluralName\":\"networking.k8s.io.ingresses\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Class\",\"type\":\"string\",\"format\":\"\",\"description\":\"The name of the IngressClass resource that should be used for additional configuration\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Hosts\",\"type\":\"string\",\"format\":\"\",\"description\":\"Hosts that incoming requests are matched against before the ingress rule\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Address\",\"type\":\"string\",\"format\":\"\",\"description\":\"Address is a list containing ingress points for the load-balancer\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Ports\",\"type\":\"string\",\"format\":\"\",\"description\":\"Ports of TLS configurations that open\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"Ingress\",\"namespaced\":true,\"resource\":\"ingresses\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"elemental.cattle.io.machineinventoryselectortemplate\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/elemental.cattle.io.machineinventoryselectortemplates\",\"self\":\"https://harvester.invalid/v1/schemas/elemental.cattle.io.machineinventoryselectortemplate\"},\"pluralName\":\"elemental.cattle.io.machineinventoryselectortemplates\",\"resourceMethods\":[\"PATCH\",\"GET\",\"DELETE\",\"PUT\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"elemental.cattle.io\",\"kind\":\"MachineInventorySelectorTemplate\",\"namespaced\":true,\"resource\":\"machineinventoryselectortemplates\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"authentication.k8s.io.tokenreview\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/authentication.k8s.io.tokenreviews\",\"self\":\"https://harvester.invalid/v1/schemas/authentication.k8s.io.tokenreview\"},\"description\":\"TokenReview attempts to authenticate a token to a known user. Note: TokenReview requests may be cached by the webhook token authenticator plugin in the kube-apiserver.\",\"pluralName\":\"authentication.k8s.io.tokenreviews\",\"resourceFields\":null,\"collectionMethods\":[\"POST\"],\"attributes\":{\"group\":\"authentication.k8s.io\",\"kind\":\"TokenReview\",\"namespaced\":false,\"resource\":\"tokenreviews\",\"verbs\":[\"create\"],\"version\":\"v1\"}},{\"id\":\"networking.k8s.io.networkpolicy\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/networking.k8s.io.networkpolicies\",\"self\":\"https://harvester.invalid/v1/schemas/networking.k8s.io.networkpolicy\"},\"description\":\"NetworkPolicy describes what network traffic is allowed for a set of Pods\",\"pluralName\":\"networking.k8s.io.networkpolicies\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Pod-Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"Selects the pods to which this NetworkPolicy object applies.  The array of ingress rules is applied to any pods selected by this field. Multiple network policies can select the same set of pods.  In this case, the ingress rules for each are combined additively. This field is NOT optional and follows standard label selector semantics. An empty podSelector matches all pods in this namespace.\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"}],\"group\":\"networking.k8s.io\",\"kind\":\"NetworkPolicy\",\"namespaced\":true,\"resource\":\"networkpolicies\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"gateway.networking.k8s.io.referencegrant\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/gateway.networking.k8s.io.referencegrants\",\"self\":\"https://harvester.invalid/v1/schemas/gateway.networking.k8s.io.referencegrant\"},\"description\":\"ReferenceGrant identifies kinds of resources in other namespaces that are\\ntrusted to reference the specified kinds of resources in the same namespace\\nas the policy.\\n\\nEach ReferenceGrant can be used to represent a unique trust relationship.\\nAdditional Reference Grants can be used to add to the set of trusted\\nsources of inbound references for the namespace they are defined within.\\n\\nAll cross-namespace references in Gateway API (with the exception of cross-namespace\\nGateway-route attachment) require a ReferenceGrant.\\n\\nReferenceGrant is a form of runtime verification allowing users to assert\\nwhich cross-namespace object references are permitted. Implementations that\\nsupport ReferenceGrant MUST NOT permit cross-namespace references which have\\nno grant, and MUST respond to the removal of a grant by revoking the access\\nthat the grant allowed.\",\"pluralName\":\"gateway.networking.k8s.io.referencegrants\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .metadata.creationTimestamp\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"group\":\"gateway.networking.k8s.io\",\"kind\":\"ReferenceGrant\",\"namespaced\":true,\"preferredVersion\":\"v1\",\"resource\":\"referencegrants\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"management.cattle.io.userattribute\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/management.cattle.io.userattributes\",\"self\":\"https://harvester.invalid/v1/schemas/management.cattle.io.userattribute\"},\"pluralName\":\"management.cattle.io.userattributes\",\"resourceMethods\":[\"blocked-PATCH\",\"GET\",\"blocked-DELETE\",\"blocked-PUT\"],\"resourceFields\":null,\"collectionMethods\":[\"blocked-POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"crdJSONPathParsers\":{\"Age\":\"{.metadata.creationTimestamp}\",\"Name\":\"{.metadata.name}\"},\"disallowMethods\":{\"DELETE\":true,\"PATCH\":true,\"POST\":true,\"PUT\":true},\"group\":\"management.cattle.io\",\"kind\":\"UserAttribute\",\"namespaced\":false,\"resource\":\"userattributes\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v3\"}},{\"id\":\"fleet.cattle.io.bundle\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/v1/fleet.cattle.io.bundles\",\"self\":\"https://harvester.invalid/v1/schemas/fleet.cattle.io.bundle\"},\"description\":\"Bundle contains the resources of an application and its deployment options.\\nIt will be deployed as a Helm chart to target clusters.\\n\\nWhen a GitRepo is scanned it will produce one or more bundles. Bundles are\\na collection of resources that get deployed to one or more cluster(s). Bundle is the\\nfundamental deployment unit used in Fleet. The contents of a Bundle may be\\nKubernetes manifests, Kustomize configuration, or Helm charts. Regardless\\nof the source the contents are dynamically rendered into a Helm chart by\\nthe agent and installed into the downstream cluster as a Helm release.\",\"pluralName\":\"fleet.cattle.io.bundles\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"POST\",\"GET\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"BundleDeployments-Ready\",\"type\":\"string\",\"format\":\"\",\"description\":\"Custom resource definition column (in JSONPath format): .status.display.readyClusters\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Status\",\"type\":\"string\",\"format\":\"\",\"description\