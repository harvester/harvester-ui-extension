,\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"harvesterhci.io.virtualmachinetemplate\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/harvesterhci.io.virtualmachinetemplates\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/harvesterhci.io.virtualmachinetemplate\"},\"pluralName\":\"harvesterhci.io.virtualmachinetemplates\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"VERSION_ID\",\"field\":\".spec.defaultVersionId\",\"type\":\"string\"},{\"name\":\"DESCRIPTION\",\"field\":\".spec.description\",\"type\":\"string\"},{\"name\":\"VERSION_DEFAULT\",\"field\":\".status.defaultVersion\",\"type\":\"integer\"},{\"name\":\"VERSION_LATEST\",\"field\":\".status.latestVersion\",\"type\":\"integer\"},{\"name\":\"AGE\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"harvesterhci.io\",\"kind\":\"VirtualMachineTemplate\",\"namespaced\":true,\"resource\":\"virtualmachinetemplates\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"clone.kubevirt.io.virtualmachineclone\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/clone.kubevirt.io.virtualmachineclones\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/clone.kubevirt.io.virtualmachineclone\"},\"description\":\"VirtualMachineClone is a CRD that clones one VM into another.\",\"pluralName\":\"clone.kubevirt.io.virtualmachineclones\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Phase\",\"field\":\".status.phase\",\"type\":\"string\"},{\"name\":\"SourceVirtualMachine\",\"field\":\".spec.source.name\",\"type\":\"string\"},{\"name\":\"TargetVirtualMachine\",\"field\":\".spec.target.name\",\"type\":\"string\"}],\"crd\":true,\"group\":\"clone.kubevirt.io\",\"kind\":\"VirtualMachineClone\",\"namespaced\":true,\"resource\":\"virtualmachineclones\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta1\"}},{\"id\":\"apps.daemonset\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/apps.daemonsets\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/apps.daemonset\"},\"description\":\"DaemonSet represents the configuration of a daemon set.\",\"pluralName\":\"apps.daemonsets\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Desired\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The total number of nodes that should be running the daemon pod (including nodes correctly running the daemon pod). More info: https://kubernetes.io/docs/concepts/workloads/controllers/daemonset/\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"},{\"name\":\"Current\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The number of nodes that are running at least 1 daemon pod and are supposed to run the daemon pod. More info: https://kubernetes.io/docs/concepts/workloads/controllers/daemonset/\",\"priority\":0,\"field\":\"$.metadata.fields[2]\"},{\"name\":\"Ready\",\"type\":\"integer\",\"format\":\"\",\"description\":\"numberReady is the number of nodes that should be running the daemon pod and have one or more of the daemon pod running with a Ready Condition.\",\"priority\":0,\"field\":\"$.metadata.fields[3]\"},{\"name\":\"Up-to-date\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The total number of nodes that are running updated daemon pod\",\"priority\":0,\"field\":\"$.metadata.fields[4]\"},{\"name\":\"Available\",\"type\":\"integer\",\"format\":\"\",\"description\":\"The number of nodes that should be running the daemon pod and have one or more of the daemon pod running and available (ready for at least spec.minReadySeconds)\",\"priority\":0,\"field\":\"$.metadata.fields[5]\"},{\"name\":\"Node Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"NodeSelector is a selector which must be true for the pod to fit on a node. Selector which must match a node's labels for the pod to be scheduled on that node. More info: https://kubernetes.io/docs/concepts/configuration/assign-pod-node/\",\"priority\":0,\"field\":\"$.metadata.fields[6]\"},{\"name\":\"Age\",\"type\":\"string\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order across separate operations. Clients may not set this value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[7]\"},{\"name\":\"Containers\",\"type\":\"string\",\"format\":\"\",\"description\":\"Names of each container in the template.\",\"priority\":1,\"field\":\"$.metadata.fields[8]\"},{\"name\":\"Images\",\"type\":\"string\",\"format\":\"\",\"description\":\"Images referenced by each container in the template.\",\"priority\":1,\"field\":\"$.metadata.fields[9]\"},{\"name\":\"Selector\",\"type\":\"string\",\"format\":\"\",\"description\":\"A label query over pods that are managed by the daemon set. Must match in order to be controlled. It must match the pod template's labels. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/labels/#label-selectors\",\"priority\":1,\"field\":\"$.metadata.fields[10]\"}],\"group\":\"apps\",\"kind\":\"DaemonSet\",\"namespaced\":true,\"resource\":\"daemonsets\",\"verbs\":[\"create\",\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"update\",\"watch\"],\"version\":\"v1\"}},{\"id\":\"management.cattle.io.clusterregistrationtoken\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/management.cattle.io.clusterregistrationtokens\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/management.cattle.io.clusterregistrationtoken\"},\"pluralName\":\"management.cattle.io.clusterregistrationtokens\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"Name\",\"type\":\"string\",\"format\":\"name\",\"description\":\"Name must be unique within a namespace. Is required when creating resources, although some resources may allow a client to request the generation of an appropriate name automatically. Name is primarily intended for creation idempotence and configuration definition. Cannot be updated. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names#names\",\"priority\":0,\"field\":\"$.metadata.fields[0]\"},{\"name\":\"Age\",\"type\":\"date\",\"format\":\"\",\"description\":\"CreationTimestamp is a timestamp representing the server time when this object was created. It is not guaranteed to be set in happens-before order 