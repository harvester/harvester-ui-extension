s value. It is represented in RFC3339 form and is in UTC.\\n\\nPopulated by the system. Read-only. Null for lists. More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#metadata\",\"priority\":0,\"field\":\"$.metadata.fields[1]\"}],\"crd\":true,\"group\":\"traefik.io\",\"kind\":\"TraefikService\",\"namespaced\":true,\"resource\":\"traefikservices\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1alpha1\"}},{\"id\":\"longhorn.io.instancemanagerupgrade\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/longhorn.io.instancemanagerupgrades\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/longhorn.io.instancemanagerupgrade\"},\"description\":\"InstanceManagerUpgrade is the Longhorn CR that tracks the live upgrade of a\\nv2 instance manager.\",\"pluralName\":\"longhorn.io.instancemanagerupgrades\",\"resourceMethods\":[\"GET\",\"DELETE\",\"PUT\",\"PATCH\",\"PATCH\"],\"resourceFields\":null,\"collectionMethods\":[\"GET\",\"POST\"],\"attributes\":{\"columns\":[{\"name\":\"State\",\"field\":\".status.state\",\"type\":\"string\"},{\"name\":\"Target Image\",\"field\":\".spec.targetImage\",\"type\":\"string\"},{\"name\":\"Age\",\"field\":\".metadata.creationTimestamp\",\"type\":\"date\"}],\"crd\":true,\"group\":\"longhorn.io\",\"kind\":\"InstanceManagerUpgrade\",\"namespaced\":true,\"resource\":\"instancemanagerupgrades\",\"verbs\":[\"delete\",\"deletecollection\",\"get\",\"list\",\"patch\",\"create\",\"update\",\"watch\"],\"version\":\"v1beta2\"}},{\"id\":\"apps.deployment\",\"type\":\"schema\",\"links\":{\"collection\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/apps.deployments\",\"self\":\"https://harvester.invalid/k8s/clusters/c-fwtnp/v1/harvester/schemas/apps.deployment\"},\"description\":\"Deployment enables declarative updates for Pods and ReplicaSets.\"